# Copy to .env and fill in. Never commit .env.

# --- required ---------------------------------------------------------------
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- AI ---------------------------------------------------------------------
# "mock" runs everything offline with no real work. Switch to "anthropic" for real agents.
LLM_PROVIDER=mock
# From https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
MANAGER_MODEL=claude-opus-5-5
SPECIALIST_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# --- guardrails (also editable live in Settings) -----------------------------
MAX_AGENTS=10
DAILY_LLM_BUDGET_USD=20
DEFAULT_AGENT_DAILY_BUDGET_USD=5
OUTREACH_DAILY_CAP=30
APPROVAL_TTL_HOURS=72
DAILY_REPORT_HOUR_UTC=7

# --- agency profile ----------------------------------------------------------
AGENCY_NAME="Agency OS"
TARGET_MARKETS=["US","UK"]

# --- environment --------------------------------------------------------------
ENVIRONMENT=development
# DATABASE_URL=postgresql+psycopg://agency:agency@localhost:5432/agency

# --- Phase 2+ (not used yet) ---------------------------------------------------
# GOOGLE_PLACES_API_KEY=
# SEARCH_API_KEY=
# PAGESPEED_API_KEY=
